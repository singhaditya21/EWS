# Copy to .env.local and fill in to switch on accounts, sync, payments and classrooms.
# Leave empty to run the free, device-only app (no sign-in).
# These values are public by design (they ship in the browser bundle); never put secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Razorpay *key id* (public). The key secret belongs only in Supabase function secrets.
VITE_RAZORPAY_KEY_ID=
